{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/engagement", "destination": "https://carrier-production-4e12.up.railway.app/api/engagement" },
    { "source": "/api/carrier", "destination": "https://carrier-production-4e12.up.railway.app/api/carrier" },
    { "source": "/world/:path*", "destination": "https://carrier-production-4e12.up.railway.app/world/:path*" },
    { "source": "/api/auth/:path*", "destination": "https://id.grudge-studio.com/auth/:path*" },
    { "source": "/api/characters/:path*", "destination": "https://api.grudge-studio.com/api/characters/:path*" },
    { "source": "/api/assets/:path*", "destination": "https://assets.grudge-studio.com/:path*" },
    { "source": "/assets/space/videos/:path*", "destination": "https://assets.grudge-studio.com/gruda-armada/space/videos/:path*" },
    { "source": "/assets-cdn/:path*", "destination": "https://assets.grudge-studio.com/:path*" },
    { "source": "/api/:path*", "destination": "https://api.grudge-studio.com/api/:path*" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/tos", "destination": "/tos.html" },
    { "source": "/ship-gallery", "destination": "/ship-gallery.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/favicon.ico", "destination": "/favicon-32.png" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
